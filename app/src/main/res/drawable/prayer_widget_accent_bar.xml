<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's gold mark.

  A drawable rather than a runtime colour because `RemoteViews` has no supported way to set a view's
  fill: `setImageViewResource` is a first-class API, while a reflective
  `setBackgroundResource`/`setBackgroundColor` call is not part of the contract every launcher
  honours. Gold is the brand's own accent and stays legible on both card tones; the colour is the
  `values`/`values-night` resource so it has one definition rather than a hex repeated here.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/prayer_widget_accent" />
    <corners android:radius="2dp" />
</shape>
