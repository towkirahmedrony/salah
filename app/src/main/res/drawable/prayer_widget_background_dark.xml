<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card in the dark appearance: the dark scheme's `surface` tone rather than pure black,
  so it still reads as a card on the app's near-black canvas, with the dark scheme's hairline as its
  border. See `prayer_widget_background_light` for why this is a separate resource.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF16221E" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#23322C" />
</shape>
