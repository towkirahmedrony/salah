<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card in the light appearance: a rounded surface with the same soft hairline the app's
  section cards use and a corner radius between the app's medium and large shape roles.

  The fill and stroke are colour resources rather than hex values so that `values-v31` can point them
  at the wallpaper's neutral tones on Android 12+ (Material You); before that they stay the app's own
  light card colours. A shape's fill cannot be swapped through RemoteViews, so the card is a drawable
  chosen at bind time — see `PrayerWidgetPalette`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/prayer_widget_card_light" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_outline_light" />
</shape>
