<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget-picker preview and the initial layout, filled with a representative reading so the
  widget does not appear empty in the picker or for the moment between being placed and its first
  bind. Every value here is replaced on the first update; the ids intentionally mirror the compact
  layout's, so the same `RemoteViews` actions address the same views.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/prayer_widget_background_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_accent"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/prayer_widget_accent_bar" />

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/prayer_fajr"
            android:textColor="@color/prayer_widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_status_active"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="@string/widget_remaining_label"
                android:textColor="@color/prayer_widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_preview_countdown"
                android:textColor="@color/prayer_widget_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
