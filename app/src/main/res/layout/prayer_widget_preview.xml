<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget-picker preview and the initial layout, filled with a representative reading so the
  widget does not appear empty in the picker or for the moment between being placed and its first
  bind. It mirrors the compact layout's composition exactly — one centred, `wrap_content` column —
  so the preview promises the same tight block the widget actually draws. Every value here is
  replaced on the first update; the ids intentionally match the compact layout's, so the same
  `RemoteViews` actions address the same views.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/prayer_widget_background_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/prayer_fajr"
            android:textColor="@color/prayer_widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_status_active"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_preview_countdown"
            android:textColor="@color/prayer_widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
