<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget-picker preview and the initial layout, filled with a representative reading so the
  widget does not appear empty in the picker or for the moment between being placed and its first
  bind. It mirrors the compact layout's composition (name and state at the top, caption and
  countdown at the bottom) on the brand's static emerald card. Every value here is replaced on the
  first update; the ids intentionally match the compact layout's.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/prayer_widget_background_brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/prayer_fajr"
            android:textColor="@color/prayer_widget_preview_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_status_active"
            android:textColor="@color/prayer_widget_preview_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_remaining_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="@string/widget_remaining_label"
            android:textColor="@color/prayer_widget_preview_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/widget_preview_countdown"
            android:textColor="@color/prayer_widget_preview_text_accent"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
