<?xml version="1.0" encoding="utf-8"?>
<!--
  The wide home-screen widget: the same reading as the compact layout, plus the boundary the
  countdown is counting to ("Maghrib at 5:42 PM"). The two columns keep the prayer's name and the
  countdown at opposite ends, so the countdown stays the thing the eye lands on.

  Both layouts share every view id except `widget_boundary`, which only this one declares; the
  updater addresses that view only when this layout is in use. The background layer works exactly as
  it does in `prayer_widget_small` — see that file for why it is an ImageView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/prayer_widget_background_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_accent"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/prayer_widget_accent_bar" />

            <TextView
                android:id="@+id/widget_prayer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/prayer_widget_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_boundary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_text_secondary"
                android:textSize="10sp" />

            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
