<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette used before Compose takes over the window. -->
    <color name="salah_window_background">#FBF8F1</color>
    <color name="salah_window_background_dark">#0F1512</color>

    <!--
      Android 12+ splash icon backdrop: the deep green from the middle stop of the Salah
      artwork's gradient (docs/artwork/salah_icon_background.svg), so the ivory and gold
      marks stay legible against the light window background. -->
    <color name="salah_splash_icon_background">#053428</color>

    <!--
      Home-screen widget defaults.

      Every text colour and the card itself are replaced at bind time by the active scheme (see
      `PrayerWidgetUpdater` and `PrayerWidgetCard`). The `prayer_widget_brand_*` and
      `prayer_widget_preview_*` colours exist so the widget picker preview and the initial layout
      render as the brand's emerald card with ivory and gold text, and so a launcher that never
      rebinds a freshly placed widget still shows something legible.
    -->
    <color name="prayer_widget_brand_start">#0C4D3B</color>
    <color name="prayer_widget_brand_end">#052A20</color>
    <color name="prayer_widget_brand_outline">#26FFFFFF</color>
    <color name="prayer_widget_preview_text_primary">#F6F1E4</color>
    <color name="prayer_widget_preview_text_secondary">#BFCEC5</color>
    <color name="prayer_widget_preview_text_accent">#E6C679</color>

    <color name="prayer_widget_text_primary">#14241D</color>
    <color name="prayer_widget_text_secondary">#5E6D66</color>

    <color name="prayer_widget_card_light">#FFFFFFFF</color>
    <color name="prayer_widget_card_dark">#FF16221E</color>
    <color name="prayer_widget_outline_light">#FFE2E0D8</color>
    <color name="prayer_widget_outline_dark">#FF23322C</color>
</resources>
