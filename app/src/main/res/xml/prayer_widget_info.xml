<?xml version="1.0" encoding="utf-8"?>
<!--
  Salah's home-screen widget.

  The precise update is the single alarm `PrayerWidgetRefreshScheduler` registers for the next
  prayer boundary, and every lifecycle event that matters (added, resized, removed, boot, app
  update) is delivered to the provider by the system.

  `updatePeriodMillis` is a 30-minute safety net, the platform minimum. The boundary alarm can be
  delayed or dropped (no exact-alarm permission, aggressive vendor battery management), and the
  Chronometer keeps counting *below zero* when nothing redraws it. The system's own periodic update
  is independent of Salah's alarm, so a missed boundary is repaired within half an hour instead of
  staying wrong until the app is opened.

  The declared height is as tall as the compact card needs for its name, state line and countdown
  with comfortable padding. A taller cell adds the caption and the boundary line.

  `targetCellWidth`/`targetCellHeight`/`previewLayout`/`description` are API 31 additions; older
  platforms ignore them and fall back to `minWidth`/`minHeight` and the app icon.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/prayer_widget_preview"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/prayer_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
