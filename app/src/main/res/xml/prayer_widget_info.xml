<?xml version="1.0" encoding="utf-8"?>
<!--
  Salah's home-screen widget.

  `updatePeriodMillis` is 0 on purpose. A periodic update would wake the device every thirty minutes
  to redraw a value the platform's Chronometer is already animating, and the labels only change at a
  prayer boundary — at most a few times a day. Those boundaries are covered by the single alarm
  `PrayerWidgetRefreshScheduler` registers, and every lifecycle event that matters (added, resized,
  removed, boot, app update) is delivered to the provider by the system.

  `targetCellWidth`/`targetCellHeight`/`previewLayout`/`description` are API 31 additions; older
  platforms ignore them and fall back to `minWidth`/`minHeight` and the app icon.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/prayer_widget_preview"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/prayer_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
